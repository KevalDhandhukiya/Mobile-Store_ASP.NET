@model IEnumerable<E_commerce_Mobile.Models.CategoryModel>

@{
    ViewData["Title"] = "Categories";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow border-0">
            <div class="card-header border-0 d-flex justify-content-between align-items-center py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div>
                    <h4 class="mb-1 fw-bold text-white">
                        <i class="fas fa-tags me-2"></i>Categories
                    </h4>
                    <p class="mb-0 small text-white" style="opacity: 0.9;">Organize your products with categories</p>
                </div>
                <a asp-action="Create" class="btn btn-light fw-bold">
                    <i class="fas fa-plus me-2"></i>Add New Category
                </a>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger border-0 shadow-sm mb-4">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Error</h6>
                                <span>@ViewBag.Error</span>
                            </div>
                        </div>
                    </div>
                }

                @if (Model?.Any() == true)
                {
                    <div class="table-responsive">
                        <table id="dataTable" class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 rounded-start ps-4">Category Name</th>
                                    <th class="border-0">Managed By</th>
                                    <th class="border-0">Created Date</th>
                                    <th class="border-0">Last Modified</th>
                                    <th class="border-0 rounded-end text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-square me-3 bg-warning bg-opacity-10 text-warning rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                                    <i class="fas fa-tag fa-lg"></i>
                                                </div>
                                                <div class="fw-bold text-dark">@category.CategoryName</div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                <i class="fas fa-user me-1 text-muted"></i> User #@category.UserId
                                            </span>
                                        </td>
                                        <td class="text-muted small">
                                            <i class="far fa-calendar-alt me-1"></i> @category.Created.ToString("MMM dd, yyyy")
                                        </td>
                                        <td class="text-muted small">
                                            @if(category.Modified != default) {
                                                <span>@category.Modified.ToString("MMM dd, yyyy")</span>
                                            } else {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group shadow-sm rounded-3 overflow-hidden" role="group">
                                                <a asp-action="Details" asp-route-id="@category.CategoryId" 
                                                   class="btn btn-sm btn-light text-primary border-end" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@category.CategoryId" 
                                                   class="btn btn-sm btn-light text-warning border-end" title="Edit Category">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@category.CategoryId" 
                                                   class="btn btn-sm btn-light text-danger" title="Delete Category"
                                                   onclick="return confirm('Are you sure you want to delete this category?')">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="mb-4">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                <i class="fas fa-folder-open fa-3x text-muted opacity-50"></i>
                            </div>
                        </div>
                        <h5 class="text-muted fw-bold mb-2">No Categories Found</h5>
                        <p class="text-muted mb-4">There are currently no categories in the system.</p>
                        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
                            <i class="fas fa-plus me-2"></i>Create First Category
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                "pageLength": 10,
                "order": [[ 2, "desc" ]]
            });
        });
    </script>
}

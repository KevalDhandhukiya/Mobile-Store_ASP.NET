@model CartModel

@{
    ViewData["Title"] = "Edit Cart Item";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Edit Cart Item</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Cart
        </a>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Edit Cart Item</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CartId" />
                <input type="hidden" asp-for="AddedDate" />
                <input type="hidden" asp-for="Created" />
                <input type="hidden" asp-for="Modified" />
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="ProductId" class="form-label">Product *</label>
                            <select asp-for="ProductId" asp-items="@(new SelectList((List<ProductModel>)ViewBag.Products, "ProductId", "ModelName"))" class="form-select" required>
                                <option value="">Select Product</option>
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="UserId" class="form-label">User *</label>
                            <select asp-for="UserId" asp-items="@(new SelectList((List<UserModel>)ViewBag.Users, "UserId", "UserName"))" class="form-select" required>
                                <option value="">Select User</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Quantity" class="form-label">Quantity *</label>
                            <input asp-for="Quantity" type="number" class="form-control" min="1" required />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Total" class="form-label">Total</label>
                            <input asp-for="Total" type="text" class="form-control" readonly />
                            <small class="form-text text-muted">Total will be calculated automatically</small>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Update Cart Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

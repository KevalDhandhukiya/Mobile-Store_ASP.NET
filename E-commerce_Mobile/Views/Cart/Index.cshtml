@model IEnumerable<E_commerce_Mobile.Models.CartModel>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow border-0">
            <div class="card-header border-0 d-flex justify-content-between align-items-center py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div>
                    <h4 class="mb-1 fw-bold text-white">
                        <i class="fas fa-shopping-cart me-2"></i>Shopping Cart
                    </h4>
                    <p class="mb-0 small text-white" style="opacity: 0.9;">Review your items before checkout</p>
                </div>
                <a asp-action="Create" class="btn btn-light fw-bold">
                    <i class="fas fa-plus me-2"></i>Add Item
                </a>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="alert alert-danger border-0 shadow-sm mb-4">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Error</h6>
                                <span>@ViewBag.Error</span>
                            </div>
                        </div>
                    </div>
                }

                @if (Model?.Any() == true)
                {
                    <div class="table-responsive">
                        <table id="dataTable" class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 rounded-start ps-4">Product</th>
                                    <th class="border-0">User</th>
                                    <th class="border-0">Quantity</th>
                                    <th class="border-0">Added Date</th>
                                    <th class="border-0 rounded-end text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            @if (item.Product != null)
                                            {
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-square me-3 bg-light rounded-3 d-flex align-items-center justify-content-center border" style="width: 50px; height: 50px;">
                                                        <i class="fas fa-mobile-alt text-secondary fa-lg"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark">@item.Product.ModelName</div>
                                                        <div class="small text-muted">@item.Product.CompanyName</div>
                                                        <div class="fw-bold text-primary mt-1">@item.Product.Price.ToString("C")</div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Product ID: @item.ProductId</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.User != null)
                                            {
                                                <span class="badge bg-light text-dark border">
                                                    <i class="fas fa-user me-1 text-muted"></i> @item.User.UserName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">ID: @item.UserId</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill border border-primary border-opacity-10 fw-bold">
                                                x @item.Quantity
                                            </span>
                                        </td>
                                        <td class="text-muted small">
                                            @item.AddedDate.ToString("MMM dd, yyyy HH:mm")
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group shadow-sm rounded-3 overflow-hidden" role="group">
                                                <a asp-action="Details" asp-route-id="@item.CartId" 
                                                   class="btn btn-sm btn-light text-primary border-end" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.CartId" 
                                                   class="btn btn-sm btn-light text-warning border-end" title="Edit Item">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.CartId" 
                                                   class="btn btn-sm btn-light text-danger" title="Remove Item"
                                                   onclick="return confirm('Are you sure you want to remove this item from cart?')">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                
                    <div class="row mt-4 justify-content-end">
                        <div class="col-md-5 col-lg-4">
                            <div class="card border-0 bg-light rounded-custom">
                                <div class="card-body p-4">
                                    <h5 class="card-title fw-bold mb-3">Cart Summary</h5>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Total Items</span>
                                        <span class="fw-bold">@Model.Count()</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-3">
                                        <span class="text-muted">Total Quantity</span>
                                        <span class="fw-bold">@Model.Sum(x => x.Quantity)</span>
                                    </div>
                                    <hr>
                                    <button class="btn btn-success w-100 py-2 fw-bold text-uppercase letter-spacing-1 shadow-sm rounded-pill mt-2">
                                        <i class="fas fa-shopping-cart me-2"></i>Checkout
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="mb-4">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                <i class="fas fa-shopping-cart fa-3x text-muted opacity-50"></i>
                            </div>
                        </div>
                        <h5 class="text-muted fw-bold mb-2">Your Cart is Empty</h5>
                        <p class="text-muted mb-4">Start shopping to add items to your cart.</p>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
                            <i class="fas fa-shopping-bag me-2"></i>Start Shopping
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                "pageLength": 10,
                "order": [[ 3, "desc" ]]
            });
        });
    </script>
}

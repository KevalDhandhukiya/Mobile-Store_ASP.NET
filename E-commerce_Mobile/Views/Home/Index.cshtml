@{
    ViewData["Title"] = "Home Page";
    var userName = Context.Session.GetString("UserName") ?? "Guest";
    var isAdmin = Context.Session.GetString("IsAdmin") == "True";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 2rem;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .hero-section h1 {
        font-weight: 700;
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }
    
    .hero-section p {
        font-size: 1.2rem;
        opacity: 0.95;
    }
    
    .hero-section .btn {
        font-weight: 600;
        padding: 12px 30px;
        border-radius: 50px;
        font-size: 1.1rem;
        margin: 5px;
    }
    
    .hero-section .btn-light {
        background: white;
        color: #667eea;
        border: none;
    }
    
    .hero-section .btn-light:hover {
        background: #f8f9fa;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }
    
    .hero-section .btn-outline-light {
        border: 2px solid white;
        color: white;
    }
    
    .hero-section .btn-outline-light:hover {
        background: white;
        color: #667eea;
    }
    
    .feature-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        height: 100%;
        background: white;
        overflow: hidden;
    }
    
    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }
    
    .feature-card .card-body {
        padding: 0;
    }
    
    .feature-card .card-header-custom {
        padding: 2rem;
        margin-bottom: 0;
    }
    
    .feature-card .card-header-custom.primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .feature-card .card-header-custom.warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }
    
    .feature-card .card-header-custom.success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }
    
    .feature-card .card-header-custom h5 {
        font-weight: 700;
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        color: white;
    }
    
    .feature-card .card-header-custom p {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1.05rem;
        margin-bottom: 0;
    }
    
    .feature-card .card-header-custom i {
        font-size: 2.5rem;
        color: white;
        margin-bottom: 1rem;
        display: block;
    }
    
    .feature-card .card-content {
        padding: 2rem;
        background: white;
    }
    
    .feature-card .card-content p {
        color: #4a5568;
        font-size: 1.05rem;
        margin-bottom: 1.5rem;
    }
    
    .feature-card .btn {
        font-weight: 600;
        padding: 10px 25px;
        border-radius: 50px;
        font-size: 1rem;
    }
    
    .icon-box {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 1rem;
    }
    
    .icon-box.primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }
    
    .icon-box.warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
    }
    
    .icon-box.success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
    }
    
    .admin-panel {
        background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%);
        color: white;
        padding: 2rem;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .admin-panel h4 {
        font-weight: 700;
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
    }
    
    .admin-panel p {
        font-size: 1.1rem;
        opacity: 0.9;
    }
    
    .admin-panel .btn {
        font-weight: 600;
        padding: 12px 30px;
        border-radius: 50px;
        background: #fbbf24;
        color: #1e3a8a;
        border: none;
        font-size: 1.1rem;
    }
    
    .admin-panel .btn:hover {
        background: #f59e0b;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }
</style>

<div class="container-fluid px-4">
    <!-- Hero Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="hero-section">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h1>Welcome to E-commerce Mobile Store!</h1>
                        <p class="lead mb-4">
                            Hello, <strong>@userName</strong>! Manage your mobile inventory, track orders, and grow your business.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-light" asp-controller="Product" asp-action="ProductList">
                                <i class="fas fa-mobile-alt me-2"></i>Browse Products
                            </a>
                            <a class="btn btn-outline-light" asp-controller="Category" asp-action="Index">
                                <i class="fas fa-tags me-2"></i>Manage Categories
                            </a>
                            <a class="btn btn-outline-light" asp-controller="Cart" asp-action="Index">
                                <i class="fas fa-shopping-cart me-2"></i>View Cart
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-4 text-center mt-4 mt-lg-0">
                        <i class="fas fa-store fa-8x" style="opacity: 0.3;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="feature-card card">
                <div class="card-body">
                    <div class="card-header-custom primary">
                        <i class="fas fa-box-open"></i>
                        <h5>Products</h5>
                        <p>Manage your mobile device inventory</p>
                    </div>
                    <div class="card-content">
                        <p>Add, edit, and organize products with ease. Keep track of stock levels and pricing.</p>
                        <a asp-controller="Product" asp-action="ProductList" class="btn btn-primary w-100">
                            <i class="fas fa-arrow-right me-2"></i>View Products
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="feature-card card">
                <div class="card-body">
                    <div class="card-header-custom warning">
                        <i class="fas fa-tags"></i>
                        <h5>Categories</h5>
                        <p>Organize your products with categories</p>
                    </div>
                    <div class="card-content">
                        <p>Create and manage product categories for better navigation and customer experience.</p>
                        <a asp-controller="Category" asp-action="Index" class="btn btn-warning w-100">
                            <i class="fas fa-arrow-right me-2"></i>Manage Categories
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="feature-card card">
                <div class="card-body">
                    <div class="card-header-custom success">
                        <i class="fas fa-shopping-bag"></i>
                        <h5>Orders</h5>
                        <p>Track sales and manage orders</p>
                    </div>
                    <div class="card-content">
                        <p>Monitor customer orders, track shipments, and analyze sales performance.</p>
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-success w-100">
                            <i class="fas fa-arrow-right me-2"></i>View Cart
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (isAdmin)
    {
        <!-- Admin Panel -->
        <div class="row">
            <div class="col-12">
                <div class="admin-panel">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-crown fa-3x me-3"></i>
                                <div>
                                    <h4 class="mb-0">Admin Dashboard</h4>
                                    <p class="mb-0">You have administrative privileges</p>
                                </div>
                            </div>
                            <p class="mb-4">
                                Access advanced features including user management, system settings, and detailed analytics.
                            </p>
                            <a asp-controller="Users" asp-action="Index" class="btn">
                                <i class="fas fa-users-cog me-2"></i>Manage Users
                            </a>
                        </div>
                        <div class="col-lg-4 text-center mt-4 mt-lg-0">
                            <i class="fas fa-shield-alt fa-6x" style="opacity: 0.2;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@model E_commerce_Mobile.Models.ProductModel
@{
    ViewData["Title"] = Model.ProductId == 0 ? "Add Product" : "Edit Product";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow border-0">
            <div class="card-header border-0 py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="d-flex align-items-center">
                    <div class="text-white me-3">
                        <i class="fas @(Model.ProductId == 0 ? "fa-plus-circle" : "fa-edit") fa-2x"></i>
                    </div>
                    <div>
                        <h4 class="mb-1 fw-bold text-white">@(Model.ProductId == 0 ? "Add New Product" : "Edit Product")</h4>
                        <p class="mb-0 small text-white" style="opacity: 0.9;">@(Model.ProductId == 0 ? "Enter product details below" : "Update product information")</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4 p-md-5 pt-4">
                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@ViewBag.Success
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show mb-4" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="SaveProduct" method="post" class="needs-validation">
                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="Created" />
                    <input type="hidden" asp-for="Modified" />
                    <input type="hidden" asp-for="UserId" value="@Context.Session.GetString("UserId")" />
                    <input type="hidden" asp-for="SpecificationId" value="0" />

                    <div class="row g-4">
                        <div class="col-12">
                            <h6 class="text-uppercase text-muted fw-bold small mb-3 letter-spacing-1">Basic Information</h6>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="ModelName" class="form-control bg-light border-0" placeholder="Model Name" />
                                <label asp-for="ModelName" class="text-muted"><i class="fas fa-mobile-alt me-2"></i>Model Name</label>
                            </div>
                            <span asp-validation-for="ModelName" class="text-danger small ps-2"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="CompanyName" class="form-control bg-light border-0" placeholder="Company Name" />
                                <label asp-for="CompanyName" class="text-muted"><i class="fas fa-building me-2"></i>Company Name</label>
                            </div>
                            <span asp-validation-for="CompanyName" class="text-danger small ps-2"></span>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="CategoryId" class="form-select bg-light border-0" asp-items="ViewBag.Categories">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <label asp-for="CategoryId" class="text-muted"><i class="fas fa-tags me-2"></i>Category</label>
                            </div>
                            <span asp-validation-for="CategoryId" class="text-danger small ps-2"></span>
                        </div>

                        <div class="col-md-6">
                             <div class="form-floating">
                                <select asp-for="UserId" class="form-select bg-light border-0" asp-items="ViewBag.Users">
                                    <option value="">-- Select User --</option>
                                </select>
                                <label asp-for="UserId" class="text-muted"><i class="fas fa-user-tag me-2"></i>Managed By</label>
                            </div>
                            <span asp-validation-for="UserId" class="text-danger small ps-2"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <h6 class="text-uppercase text-muted fw-bold small mb-3 letter-spacing-1">Pricing & Inventory</h6>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Price" class="form-control bg-light border-0" type="number" step="0.01" placeholder="Price" />
                                <label asp-for="Price" class="text-muted"><i class="fas fa-dollar-sign me-2"></i>Price</label>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small ps-2"></span>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Stock" class="form-control bg-light border-0" type="number" placeholder="Stock" />
                                <label asp-for="Stock" class="text-muted"><i class="fas fa-boxes me-2"></i>Stock Quantity</label>
                            </div>
                            <span asp-validation-for="Stock" class="text-danger small ps-2"></span>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="LaunchDate" class="form-control bg-light border-0" type="date" placeholder="Launch Date" />
                                <label asp-for="LaunchDate" class="text-muted"><i class="fas fa-calendar-alt me-2"></i>Launch Date</label>
                            </div>
                            <span asp-validation-for="LaunchDate" class="text-danger small ps-2"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <h6 class="text-uppercase text-muted fw-bold small mb-3 letter-spacing-1">Details & visibility</h6>
                        </div>

                         <div class="col-12">
                            <div class="form-floating">
                                <textarea asp-for="Description" class="form-control bg-light border-0" style="height: 100px" placeholder="Description"></textarea>
                                <label asp-for="Description" class="text-muted"><i class="fas fa-align-left me-2"></i>Description</label>
                            </div>
                            <span asp-validation-for="Description" class="text-danger small ps-2"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch p-3 bg-light rounded-3 d-flex align-items-center">
                                <input asp-for="IsRemoved" class="form-check-input ms-0 me-3" style="width: 3em; height: 1.5em;" />
                                <div>
                                    <label asp-for="IsRemoved" class="form-check-label fw-bold mb-0">
                                        Hide Product
                                    </label>
                                    <div class="text-muted small">If checked, this product will be hidden from the public catalog.</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-5">
                            <hr class="border-light mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-action="Index" class="btn btn-light text-muted fw-bold px-4 rounded-pill shadow-sm border">
                                    <i class="fas fa-arrow-left me-2"></i>Back to List
                                </a>
                                <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill shadow fw-bold">
                                    <i class="fas fa-save me-2"></i>@(Model.ProductId == 0 ? "Create Product" : "Save Changes")
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


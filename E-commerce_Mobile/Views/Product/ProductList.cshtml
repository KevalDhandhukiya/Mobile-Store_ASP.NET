@model List<E_commerce_Mobile.Models.ProductModel>

@{
    ViewData["Title"] = "Product List";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                <div>
                    <h4 class="mb-1 fw-bold">
                        <i class="fas fa-mobile-alt me-2"></i>Product Inventory
                    </h4>
                    <p class="mb-0 small opacity-75">Manage your mobile devices and stock levels</p>
                </div>
                <a asp-action="AddProduct" class="btn btn-light fw-bold">
                    <i class="fas fa-plus me-2"></i>Add New Product
                </a>
            </div>
            <div class="card-body p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong><i class="fas fa-check-circle me-2"></i>Success!</strong> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (Model?.Count > 0)
                {
                    <div class="table-responsive">
                        <table id="productTable" class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 rounded-start ps-4">Product Info</th>
                                    <th class="border-0">Category</th>
                                    <th class="border-0">Price</th>
                                    <th class="border-0">Stock Status</th>
                                    <th class="border-0">Launch Date</th>
                                    <th class="border-0 rounded-end text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3" style="width: 60px; height: 60px; position: relative;">
                                                    @{
                                                        // Generate image path based on model name
                                                        var modelName = product.ModelName?.ToLower().Replace(" ", "-") ?? "default";
                                                        var imagePath = $"/images/products/{modelName}.png";
                                                        var defaultImage = "/images/products/default-phone.png";
                                                    }
                                                    <img src="@imagePath" 
                                                         onerror="this.onerror=null; this.src='@defaultImage';" 
                                                         alt="@product.ModelName" 
                                                         class="img-fluid rounded-3 shadow-sm"
                                                         style="width: 60px; height: 60px; object-fit: cover; border: 2px solid #f0f0f0;" />
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@(product.ModelName ?? "N/A")</div>
                                                    <div class="small text-muted">@product.CompanyName</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (product.Category != null)
                                            {
                                                <span class="badge bg-light text-dark border">
                                                    <i class="fas fa-tag me-1 text-muted"></i>@product.Category.CategoryName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic">Uncategorized</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-bold text-primary">
                                                @product.Price.ToString("C")
                                            </span>
                                        </td>
                                        <td>
                                            @if (product.Stock > 10)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill border border-success border-opacity-10">
                                                    <i class="fas fa-check-circle me-1"></i> In Stock (@product.Stock)
                                                </span>
                                            }
                                            else if (product.Stock > 0)
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill border border-warning border-opacity-10">
                                                    <i class="fas fa-exclamation-circle me-1"></i> Low Stock (@product.Stock)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill border border-danger border-opacity-10">
                                                    <i class="fas fa-times-circle me-1"></i> Out of Stock
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="text-muted small">
                                                @product.LaunchDate.ToString("MMM dd, yyyy")
                                            </div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group shadow-sm rounded-3 overflow-hidden" role="group">
                                                @if (product.Stock > 0 && !product.IsRemoved)
                                                {
                                                    <button class="btn btn-sm btn-light text-success border-end add-to-cart-btn" 
                                                            data-product-id="@product.ProductId" 
                                                            title="Add to Cart">
                                                        <i class="fas fa-cart-plus"></i>
                                                    </button>
                                                }
                                                <a asp-action="Details" asp-route-id="@product.ProductId" 
                                                   class="btn btn-sm btn-light text-primary border-end" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@product.ProductId" 
                                                   class="btn btn-sm btn-light text-warning border-end" title="Edit Product">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="DeleteProduct" asp-route-id="@product.ProductId" 
                                                   class="btn btn-sm btn-light text-danger" title="Delete Product"
                                                   onclick="return confirm('Are you sure you want to delete this product?')">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="mb-4">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                <i class="fas fa-box-open fa-3x text-muted opacity-50"></i>
                            </div>
                        </div>
                        <h5 class="text-muted fw-bold mb-2">No Products Found</h5>
                        <p class="text-muted mb-4">Get started by adding your first mobile device.</p>
                        <a asp-action="AddProduct" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
                            <i class="fas fa-plus me-2"></i>Add First Product
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log('Product list loaded successfully');
            
            // Handle Add to Cart button clicks
            $('.add-to-cart-btn').on('click', function(e) {
                e.preventDefault();
                var button = $(this);
                var productId = button.data('product-id');
                var originalText = button.html();
                
                // Disable button and show loading state
                button.prop('disabled', true);
                button.html('<i class="fas fa-spinner fa-spin"></i>');
                
                // Send AJAX request to add item to cart
                $.ajax({
                    url: '/Cart/AddToCart',
                    type: 'POST',
                    data: {
                        productId: productId,
                        quantity: 1,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            // Show success message
                            showNotification('success', response.message);
                            // Temporarily change button to indicate success
                            button.removeClass('btn-success').addClass('btn-info');
                            button.html('<i class="fas fa-check"></i>');
                            
                            setTimeout(function() {
                                button.removeClass('btn-info').addClass('btn-success');
                                button.html(originalText);
                                button.prop('disabled', false);
                            }, 2000);
                        } else {
                            showNotification('error', response.message);
                            button.html(originalText);
                            button.prop('disabled', false);
                        }
                    },
                    error: function(xhr, status, error) {
                        showNotification('error', 'Failed to add item to cart. Please try again.');
                        button.html(originalText);
                        button.prop('disabled', false);
                    }
                });
            });
            
            // Function to show notifications
            function showNotification(type, message) {
                var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
                var icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
                
                var notification = $('<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                    '<i class="fas ' + icon + ' me-2"></i>' + message +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                    '</div>');
                
                // Insert notification at the top of the card body
                $('.card-body').prepend(notification);
                
                // Auto-hide after 5 seconds
                setTimeout(function() {
                    notification.fadeOut(function() {
                        $(this).remove();
                    });
                }, 5000);
            }
        });
    </script>
}

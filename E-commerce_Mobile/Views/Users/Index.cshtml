@model List<E_commerce_Mobile.Models.UserModel>

@{
    ViewData["Title"] = "Users Management";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow border-0">
            <div class="card-header border-0 d-flex justify-content-between align-items-center py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div>
                    <h4 class="mb-1 fw-bold text-white">
                        <i class="fas fa-users me-2"></i>Users Management
                    </h4>
                    <p class="mb-0 small text-white" style="opacity: 0.9;">Manage your application users and roles</p>
                </div>
                <a asp-action="Create" class="btn btn-light fw-bold">
                    <i class="fas fa-plus me-2"></i>Add New User
                </a>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm mb-4">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Error</h6>
                                <span>@ViewBag.Error</span>
                            </div>
                        </div>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success border-0 shadow-sm mb-4">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-check-circle me-3 fs-4"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Success</h6>
                                <span>@TempData["Success"]</span>
                            </div>
                        </div>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm mb-4">
                         <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Error</h6>
                                <span>@TempData["Error"]</span>
                            </div>
                        </div>
                    </div>
                }

                @if (Model?.Count > 0)
                {
                    <div class="table-responsive">
                        <table id="usersTable" class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 rounded-start ps-4">User</th>
                                    <th class="border-0">Role</th>
                                    <th class="border-0">Status</th>
                                    <th class="border-0">Contact Info</th>
                                    <th class="border-0">Created</th>
                                    <th class="border-0 rounded-end text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle me-3 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@user.UserName</div>
                                                    <div class="small text-muted">ID: @user.UserId</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (user.IsAdmin)
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill border border-danger border-opacity-10">
                                                    <i class="fas fa-shield-alt me-1"></i> Admin
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill border border-info border-opacity-10">
                                                    <i class="fas fa-user me-1"></i> User
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill border border-success border-opacity-10">
                                                    <i class="fas fa-check-circle me-1"></i> Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill border border-secondary border-opacity-10">
                                                    <i class="fas fa-times-circle me-1"></i> Inactive
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <span class="mb-1"><i class="fas fa-envelope text-muted me-2 small"></i>@(user.Email ?? "N/A")</span>
                                                <span class="small text-muted"><i class="fas fa-phone text-muted me-2 small"></i>@(user.Contact ?? "N/A")</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="text-muted small">
                                                <i class="far fa-calendar-alt me-1"></i>
                                                @user.Created.ToString("MMM dd, yyyy")
                                            </div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group shadow-sm rounded-3 overflow-hidden" role="group">
                                                <a asp-action="Details" asp-route-id="@user.UserId" 
                                                   class="btn btn-sm btn-light text-primary border-end" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@user.UserId" 
                                                   class="btn btn-sm btn-light text-warning border-end" title="Edit User">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@user.UserId" 
                                                   class="btn btn-sm btn-light text-danger" title="Delete User"
                                                   onclick="return confirm('Are you sure you want to delete this user?')">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="mb-4">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                <i class="fas fa-users fa-3x text-muted opacity-50"></i>
                            </div>
                        </div>
                        <h5 class="text-muted fw-bold mb-2">No Users Found</h5>
                        <p class="text-muted mb-4">Get started by creating your first user account.</p>
                        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm">
                            <i class="fas fa-plus me-2"></i>Add First User
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log('Users list loaded successfully');
        });
    </script>
}
